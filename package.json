{
  "name": "milestoneproof",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --filter @milestoneproof/web dev",
    "build": "pnpm --filter @milestoneproof/contracts build && pnpm --filter @milestoneproof/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @milestoneproof/contracts test && pnpm --filter @milestoneproof/web test",
    "lint": "pnpm --filter @milestoneproof/web lint",
    "runner:dev": "pnpm --filter @milestoneproof/runner dev",
    "runner:deploy": "pnpm --filter @milestoneproof/runner deploy"
  },
  "devDependencies": {
    "next": "16.2.10"
  }
}
