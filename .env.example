# AI (bring your own key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
NEXT_PUBLIC_GEMINI_SERVICE_TIER=unpaid
# Set both values only after the API project is visibly on Gemini's paid tier.
# A public "paid" label without this server-only confirmation fails closed.
GEMINI_PAID_TIER_CONFIRMED=false

# Supabase (required for durable verification, review, and approval records)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runner integration
RUNNER_URL=
RUNNER_HMAC_SECRET=
RECORD_HASH_SECRET=
CRON_SECRET=
GREENLIT_ORIGIN_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional public scheduling link shown after a demo request is recorded.
NEXT_PUBLIC_DEMO_BOOKING_URL=
STRIPE_APP_CLIENT_ID=
# External-test Stripe App install/OAuth URL from Stripe Workbench.
STRIPE_APP_INSTALL_URL=
# Use a test-mode developer key for the closed beta.
STRIPE_SECRET_KEY=
# Generate with: openssl rand -base64 32
STRIPE_TOKEN_ENCRYPTION_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false until a responsible operator explicitly approves live invoices.
STRIPE_ALLOW_LIVE_MODE=false
STRIPE_API_VERSION=2026-02-25.clover

# Closed-beta access and capacity (comma-separated exact emails)
BETA_ALLOWED_EMAILS=
ADMIN_EMAILS=
BETA_DAILY_RUN_LIMIT=8
BETA_DAILY_ANALYSIS_LIMIT=100
BETA_EVIDENCE_STORAGE_LIMIT_BYTES=850000000

# Emergency workflow switches. Environment=true overrides the operator
# console; keep false during normal operation.
BETA_PAUSE_RUNS=false
BETA_PAUSE_REVIEWS=false
BETA_PAUSE_INVOICES=false
BETA_PAUSE_REASON=

# Public operator identity shown in legal notices
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_GOVERNING_LAW=
NEXT_PUBLIC_VENUE=
NEXT_PUBLIC_NOTIFICATION_PROVIDER=

# Set true only after the named operational check has actually been completed
# and its evidence is recorded in docs/PRODUCTION_SIGNOFF.md.
CUSTOM_SMTP_CONFIRMED=false
LINK_SCANNER_TEST_CONFIRMED=false
BACKUP_SCHEDULE_CONFIRMED=false
RESTORE_DRILL_CONFIRMED=false
INCIDENT_OWNERS_ASSIGNED=false

# Operations: local encrypted/off-site backup staging (never commit these)
DATABASE_URL=
BACKUP_OUTPUT_DIR=
BACKUP_ENCRYPTION_RECIPIENT=
RESTORE_DATABASE_URL=
EXPECTED_SUPABASE_HOST=

# Optional no-vendor notification webhook (in-app notifications work without it)
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
